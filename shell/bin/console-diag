#!/usr/bin/env bash
# console-diag — rassemble ce qu'il faut pour comprendre un souci d'image ou d'émulateur.
# À lancer en SSH avec l'utilisateur de la console (pas en root), pendant que le problème est à
# l'écran (ou juste après pour un jeu qui ne démarre pas). N'affiche aucun mot de passe.
set -u
uid=$(id -u)
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$uid}
if [[ -z ${SWAYSOCK:-} ]]; then
  for s in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do [[ -S $s ]] && export SWAYSOCK=$s && break; done
fi
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  for w in "$XDG_RUNTIME_DIR"/wayland-*; do [[ -S $w ]] && export WAYLAND_DISPLAY=${w##*/} && break; done
fi
VAR=$HOME/.var/app
LOGS=$HOME/.local/state/console/logs
section() { printf '\n===== %s =====\n' "$1"; }

section "Version"
[[ -r /etc/console/install.env ]] && . /etc/console/install.env
echo "Installée : $(cat /opt/console/VERSION 2>/dev/null || echo inconnue)"
if [[ -n ${CONSOLE_REPO:-} && -d $CONSOLE_REPO/.git ]]; then
  echo "Dépôt     : $(git -C "$CONSOLE_REPO" log -1 --format='%h du %cd' --date=format-local:'%d/%m/%Y %H:%M' 2>/dev/null)"
fi

section "Écrans"
if outputs=$(swaymsg -t get_outputs -r 2>/dev/null); then
  jq -r '.[] | "\(.name)  actif=\(.active)  mode=\(.current_mode.width // "-")x\(.current_mode.height // "-")  échelle=\(.scale // "-")  position=\(.rect.x),\(.rect.y)  taille=\(.rect.width)x\(.rect.height)"' <<< "$outputs"
else
  echo "sway injoignable : lance cette commande avec l'utilisateur de la console, pendant que l'interface tourne"
fi

section "Sway"
swaymsg -t get_version -r 2>/dev/null | jq -r '"version \(.human_readable)"'
sp=$(pgrep -u "$uid" -x sway | head -n 1)
if [[ -n $sp ]]; then
  if tr '\0' '\n' < "/proc/$sp/environ" 2>/dev/null | grep -qx 'WLR_SCENE_DISABLE_DIRECT_SCANOUT=1'; then
    echo "envoi direct des jeux à l'écran (direct scanout) : désactivé"
  else
    echo "envoi direct des jeux à l'écran (direct scanout) : actif (redémarre la console après la mise à jour)"
  fi
fi
echo "Dernières erreurs de sway et du pilote graphique :"
jl=$(journalctl --user -b -t sway -n 25 --no-pager -q 2>/dev/null)
[[ -z $jl ]] && jl=$(journalctl -b -t sway -n 25 --no-pager -q 2>/dev/null)
if [[ -n $jl ]]; then
  sed 's/^/  /' <<< "$jl"
else
  echo "  (journal illisible avec cet utilisateur : sudo journalctl -b -t sway -n 25)"
fi
journalctl -k -b --no-pager -q 2>/dev/null | grep -iE 'i915|drm|gpu hang' | tail -n 8 | sed 's/^/  /'

section "Fenêtres"
swaymsg -t get_tree -r 2>/dev/null | jq -r '.. | objects | select((.pid? // 0) > 0) | "\(.app_id // .window_properties.class // "?")  [\(.shell // "?")]  cadre=\(.rect.width)x\(.rect.height)+\(.rect.x)+\(.rect.y)  contenu=\(.geometry.width)x\(.geometry.height)  fenêtre=\(.window_rect.width)x\(.window_rect.height)+\(.window_rect.x)+\(.window_rect.y)  plein-écran=\(.fullscreen_mode)  visible=\(.visible)  focus=\(.focused)"'

section "RetroArch"
RA=$VAR/org.libretro.RetroArch/config/retroarch
grep -E '^(video_driver|video_context_driver|driver_switch_enable|video_fullscreen|savestate_auto_save|savestate_auto_load|rgui_config_directory|global_core_options|game_specific_options|auto_overrides_enable|core_options_path|pause_nonactive|input_driver|audio_driver|audio_device|audio_sync|video_vsync|video_threaded|video_frame_delay|video_max_swapchain_images|audio_enable|audio_mute_enable|aspect_ratio_index|custom_viewport_width|custom_viewport_height|video_scale_integer|video_shader_enable|video_rotation|video_windowed_fullscreen|video_monitor_index) ' "$RA/retroarch.cfg" 2>/dev/null
echo "Cœurs :"
for c in "$RA"/cores/*_libretro.so; do [[ -f $c ]] && printf '  %-34s %s octets\n' "$(basename "$c")" "$(stat -c %s "$c")"; done
echo "Réglages propres à un cœur ou à un jeu :"
find "$RA/config" -type f \( -name '*.cfg' -o -name '*.opt' \) -printf '  %P\n' 2>/dev/null
for f in "$RA"/config/Mupen64Plus-Next/*; do
  [[ -f $f ]] || continue
  echo "  $(basename "$f") :"
  grep -E '^(mupen64plus-(rdp|rsp)-plugin|mupen64plus-cpucore|video_driver|savestate_auto_load|state_slot) ' "$f" | sed 's/^/    /'
done

section "Image à l'écran"
# Capture de ce que sway affiche vraiment : noir partout, ou une image ?
if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v grim >/dev/null; then
  grim -t ppm - 2>/dev/null | python3 -I -c '
import re, sys
data = sys.stdin.buffer.read()
m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+\d+\s", data)
if not m:
    sys.exit("capture impossible")
w, h = int(m.group(1)), int(m.group(2))
pix = memoryview(data)[m.end():]
step = 15                                     # un pixel sur cinq
r, g, b = pix[0::step], pix[1::step], pix[2::step]
n = len(b)
lit = sum(1 for x, y, z in zip(r, g, b) if x > 24 or y > 24 or z > 24)
print(f"{w}x{h} : {100 * lit / max(n, 1):.1f} % de l\x27image n\x27est pas noire")
'
else
  echo "capture impossible (grim ou l'affichage sont injoignables)"
fi

section "Activité des émulateurs (mesurée pendant 2 s)"
python3 -I - <<'PY'
import os, re, time
NAMES = re.compile(r"^(retroarch|dolphin-emu|pcsx2-qt|azahar.*)$")
HZ = os.sysconf("SC_CLK_TCK")


def tasks(pid):
    out = {}
    try:
        tids = os.listdir(f"/proc/{pid}/task")
    except OSError:
        return out
    for tid in tids:
        try:
            with open(f"/proc/{pid}/task/{tid}/stat") as f:
                s = f.read()
            with open(f"/proc/{pid}/task/{tid}/comm") as f:
                comm = f.read().strip()
        except OSError:
            continue
        rest = s[s.rindex(")") + 2:].split()
        out[int(tid)] = (comm, rest[0], int(rest[11]) + int(rest[12]))
    return out


def wchan(pid, tid):
    try:
        with open(f"/proc/{pid}/task/{tid}/wchan") as f:
            w = f.read().strip()
    except OSError:
        return "?"
    return w if w and w != "0" else "?"


procs = {}
for d in os.listdir("/proc"):
    if d.isdigit():
        try:
            with open(f"/proc/{d}/comm") as f:
                name = f.read().strip()
        except OSError:
            continue
        if NAMES.match(name):
            procs[int(d)] = name
if not procs:
    print("aucun émulateur en cours")
before = {pid: tasks(pid) for pid in procs}
time.sleep(2)
for pid, name in procs.items():
    rows = []
    for tid, (comm, state, ticks) in tasks(pid).items():
        old = before[pid].get(tid, (comm, state, ticks))[2]
        rows.append(((ticks - old) * 100 / (2 * HZ), tid, comm, state))
    print(f"{name} (pid {pid}) : {sum(r[0] for r in rows):.0f} % de processeur, {len(rows)} fils")
    for cpu, tid, comm, state in sorted(rows, key=lambda r: (r[1] != pid, -r[0]))[:8]:
        print(f"  {'principal ' if tid == pid else ''}{comm:<16} {cpu:4.0f} %  état {state}  attend dans {wchan(pid, tid)}")
PY

section "Son"
python3 -I - <<'PY'
import json, subprocess


def pactl(*args):
    try:
        out = subprocess.run(["pactl", "-f", "json", *args], capture_output=True, text=True, timeout=5).stdout
        return json.loads(out) if out.strip() else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


info, sinks, inputs = pactl("info"), pactl("list", "sinks") or [], pactl("list", "sink-inputs") or []
if info is None:
    print("serveur de son injoignable")
else:
    print("Sortie par défaut :", info.get("default_sink_name"))
names = {}
for s in sinks:
    names[s.get("index")] = s.get("name")
    print(f"  sortie {s.get('name')} : {s.get('state')}, port {s.get('active_port')}, muet={s.get('mute')}")
for i in inputs:
    props = i.get("properties") or {}
    print(f"  flux {props.get('application.name')} ({props.get('media.name')}) → {names.get(i.get('sink'), i.get('sink'))},"
          f" en pause={i.get('corked')}, muet={i.get('mute')}")
if info is not None and not inputs:
    print("  aucun flux en cours")
PY

section "Volant (VirtualHere)"
if [[ -x /usr/local/sbin/vhusbdx86_64 ]]; then
  echo "service : $(systemctl is-active virtualhere.service 2>/dev/null)"
  if ss -ltn 2>/dev/null | grep -q ':7575 '; then echo "écoute sur le port 7575 : oui"; else echo "écoute sur le port 7575 : non"; fi
  grep -E '^(ServerName|IgnoredDevices)=' /usr/local/etc/virtualhere/config.ini 2>/dev/null
  ts=$(tailscale ip -4 2>/dev/null | head -n 1)
  [[ -n $ts ]] && echo "adresse à donner au client VirtualHere du PC : $ts:7575"
else
  echo "serveur VirtualHere non installé (sudo ./update.sh --only 72)"
fi
found=0
for d in /sys/bus/usb/devices/*; do
  [[ $(cat "$d/idVendor" 2>/dev/null) == 346e ]] || continue
  found=1
  echo "Moza branché : $(cat "$d/product" 2>/dev/null || echo ?) ($(cat "$d/idVendor"):$(cat "$d/idProduct"), pilote $(basename "$(readlink -f "$d"/*:1.0/driver 2>/dev/null)" 2>/dev/null))"
done
(( found )) || echo "aucun appareil Moza branché"

section "Dolphin"
grep -HE '^(GFXBackend|Fullscreen|RenderToMain|FullscreenDisplayRes|AspectRatio|InternalResolution|wideScreenHack|Crop) ' \
  "$VAR/org.DolphinEmu.dolphin-emu/config/dolphin-emu/Dolphin.ini" "$VAR/org.DolphinEmu.dolphin-emu/config/dolphin-emu/GFX.ini" 2>/dev/null \
  | sed "s#^$VAR/org.DolphinEmu.dolphin-emu/config/dolphin-emu/##"

section "Jeux N64"
for f in "$HOME"/ROMs/n64/*; do
  [[ -f $f ]] || continue
  printf '  %s  %s octets  en-tête %s\n' "$(basename "$f")" "$(stat -c %s "$f")" "$(head -c 4 "$f" | od -An -tx1 | tr -d ' \n')"
done

section "Derniers journaux des émulateurs"
for f in "$LOGS"/emu-*.log "$LOGS"/game.log; do
  [[ -f $f ]] || continue
  echo "--- $(basename "$f")  ($(date -r "$f" '+%d/%m %H:%M'))"
  head -n 3 "$f" | grep '^# '                   # commande lancée et version de la console
  if [[ $f == */emu-retroarch.log ]]; then
    echo "  [lignes clés]"
    grep -aE '\[(Core|Overrides|Config)\]|SET_HW_RENDER|driver forced|cached driver|\[Vulkan\]|ERROR|WARN|mupen64plus: (Selected|Requested)' "$f" | head -n 40
    echo "  [fin du journal]"
  fi
  grep -vE '^\s*$' "$f" | tail -n 40
done
if [[ -f $HOME/ES-DE/logs/es_log.txt ]]; then
  echo "--- ES-DE"
  grep -E 'Launching|launch|Error|error|Warning' "$HOME/ES-DE/logs/es_log.txt" | tail -n 8
fi
